# Cloud Functions `api` 関数のベース URL（末尾スラッシュなし）
# 疎通確認: curl "$VITE_API_URL/ping"
VITE_API_URL=https://asia-northeast1-quest-time-coupon-95106.cloudfunctions.net/api

# API 共有キー（Functions 側 Secret Manager の API_SECRET と同じ値）
VITE_API_KEY=your-secret-key

# true のときモック API を使用（Functions 未接続時の開発用。本番は false）
VITE_MOCK_API=true
